          "query": "grid = from(bucket: \"waid-bucket\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"mqtt_consumer\" and r[\"_field\"] == \"total_act_power\")\n  |> drop(columns: [\"host\", \"topic\"])\n  |> group()\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> map(fn: (r) => ({r with _field: \"grid\"}))\nsolar = from(bucket: \"waid-bucket\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"solar\" and r[\"_field\"] == \"power\" and r.channel == \"0\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> drop(columns: [\"host\", \"channel\", \"serial\", \"topic\"])\n  |> group()\n  |> map(fn: (r) => ({r with _field: \"solar\"}))\nunion(tables: [grid, solar])\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> map(fn: (r) => ({\n      _time: r._time,\n      Grid: r.grid,\n      Solar: if exists r.solar then r.solar else 0.0,\n      \"House load\": r.grid + (if exists r.solar then r.solar else 0.0)\n    }))\n  |> group()\n"
