          "query": "import \"date\"\nimport \"timezone\"\noption location = timezone.location(name: \"Europe/Zurich\")\nday_start = date.truncate(t: v.timeRangeStop, unit: 1d)\nday_stop = date.add(d: 1d, to: day_start)\n\nratio = (tables=<-) => tables\n  |> filter(fn: (r) => r[\"_measurement\"] == \"energy_balance\")\n  |> filter(fn: (r) => r[\"_field\"] == \"kept_ht_kwh\" or r[\"_field\"] == \"kept_nt_kwh\" or r[\"_field\"] == \"import_kwh\")\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> map(fn: (r) => {\n      kept = (if exists r.kept_ht_kwh then r.kept_ht_kwh else 0.0) + (if exists r.kept_nt_kwh then r.kept_nt_kwh else 0.0)\n      house = (if exists r.import_kwh then r.import_kwh else 0.0) + kept\n      return {_time: r._time, _value: if house > 0.0 then kept / house else 0.0}\n    })\ntoday = from(bucket: \"waid-bucket-downsampled\")\n  |> range(start: day_start, stop: day_stop)\n  |> ratio()\n  |> map(fn: (r) => ({r with _field: \"today\"}))\nmedian30 = from(bucket: \"waid-bucket-downsampled\")\n  |> range(start: date.add(d: -30d, to: day_start), stop: day_start)\n  |> ratio()\n  |> group()\n  |> median()\n  |> map(fn: (r) => ({_time: day_start, _value: r._value, _field: \"30d median\"}))\nunion(tables: [today, median30])\n  |> group(columns: [\"_field\"])\n"
