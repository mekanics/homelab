      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${datasource}"
          },
          "query": "import \"date\"\nfrom(bucket: \"waid-bucket\")\n  |> range(start: date.sub(d: 5m, from: v.timeRangeStop), stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"mqtt_consumer\" and r[\"_field\"] == \"total_act_power\")\n  |> last()\n  |> map(fn: (r) => ({\n      _time: r._time,\n      _value: if r._value < 0.0 then -r._value else r._value,\n      _field: if r._value < -30.0 then \"Exporting\" else if r._value > 30.0 then \"Importing\" else \"Idle\"\n    }))\n"
        }
      ]
