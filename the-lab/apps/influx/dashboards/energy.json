      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${datasource}"
          },
          "query": "import \"date\"\nimport \"timezone\"\noption location = timezone.location(name: \"Europe/Zurich\")\nhour = date.hour(t: v.timeRangeStop)\ndaytime = hour >= 8 and hour < 17\nsolar = from(bucket: \"waid-bucket\")\n  |> range(start: date.sub(d: 120m, from: v.timeRangeStop), stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"solar\" and r[\"_field\"] == \"power\" and r.channel == \"0\")\n  |> aggregateWindow(every: 5m, fn: mean, createEmpty: true)\n  |> fill(value: 0.0)\n  |> last()\n  |> toFloat()\n  |> map(fn: (r) => ({_time: v.timeRangeStop, _value: r._value, _field: \"solar\"}))\nreach = from(bucket: \"waid-bucket\")\n  |> range(start: date.sub(d: 120m, from: v.timeRangeStop), stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"status\" and r[\"_field\"] == \"reachable\")\n  |> last()\n  |> toFloat()\n  |> map(fn: (r) => ({_time: v.timeRangeStop, _value: r._value, _field: \"reachable\"}))\nunion(tables: [solar, reach])\n  |> group()\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> map(fn: (r) => {\n      s = if exists r.solar then r.solar else 0.0\n      reachable = if exists r.reachable then r.reachable else 0.0\n      word = if s > 0.0 then \"Producing\" else if daytime and reachable < 1.0 then \"Down\" else \"Asleep\"\n      return {_time: r._time, _value: 1.0, _field: word}\n    })\n  |> group(columns: [\"_field\"])\n"
        }
      ]
    },
